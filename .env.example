# ==============================================================================
# Prism - Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Google API Key for Google Fact Check Tools API
# Get your API key from Google Cloud Console with Fact Check Tools API enabled:
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_API_KEY=your_google_fact_check_api_key_here

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prism_db
