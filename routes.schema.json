{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrismRoutingSchema",
  "description": "Standardized routing schema for Prism client-side pages, API endpoints, and Vercel edge rewrite rules.",
  "version": "1.0.0",
  "type": "object",
  "required": ["version", "clientRoutes", "apiRoutes", "edgeRewrites"],
  "properties": {
    "version": {
      "type": "string",
      "example": "1.0.0"
    },
    "clientRoutes": {
      "type": "array",
      "description": "Client-side SPA routes handled by the internal router",
      "items": {
        "type": "object",
        "required": ["id", "path", "title", "navLabel", "category"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "title": { "type": "string" },
          "navLabel": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "category": { "type": "string", "enum": ["studio", "analytics", "developer", "system"] },
          "badge": { "type": "string" },
          "navbar": { "type": "boolean" },
          "vercelRewrite": { "type": "string" }
        }
      }
    },
    "apiRoutes": {
      "type": "array",
      "description": "Backend API routes exposed by FastAPI",
      "items": {
        "type": "object",
        "required": ["endpoint", "method", "summary"],
        "properties": {
          "endpoint": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
          "summary": { "type": "string" },
          "module": { "type": "string" },
          "authRequired": { "type": "boolean" },
          "rateLimit": { "type": "string" }
        }
      }
    },
    "edgeRewrites": {
      "type": "array",
      "description": "Vercel edge rewrite rules defined in vercel.json",
      "items": {
        "type": "object",
        "required": ["source", "destination"],
        "properties": {
          "source": { "type": "string" },
          "destination": { "type": "string" },
          "type": { "type": "string", "enum": ["api_proxy", "serverless_function", "spa_fallback", "static_asset"] },
          "comment": { "type": "string" }
        }
      }
    }
  },
  "routes": [
    {
      "id": "verifier",
      "path": "/",
      "title": "Social Link Verifier Studio",
      "navLabel": "Verifier",
      "description": "Multi-platform social URL verification, caption extraction, and Indic translation studio",
      "icon": "verifier",
      "category": "studio",
      "navbar": true,
      "vercelRewrite": "/index.html"
    },
    {
      "id": "api-studio",
      "path": "/api-studio",
      "title": "API Call Console & Code Playground",
      "navLabel": "API Studio",
      "description": "Interactive developer console, cURL/Python/JavaScript code generator and schema inspector",
      "icon": "api",
      "category": "developer",
      "navbar": true,
      "vercelRewrite": "/index.html"
    },
    {
      "id": "history",
      "path": "/history",
      "title": "Verification Audit Trail & History",
      "navLabel": "History",
      "description": "Complete searchable ledger of processed social media claims and publisher ratings",
      "icon": "history",
      "category": "studio",
      "navbar": true,
      "vercelRewrite": "/index.html"
    },
    {
      "id": "vercel",
      "path": "/vercel",
      "title": "Vercel Edge Routing & Deployment Architecture",
      "navLabel": "Vercel & Schemas",
      "description": "Deployment topology, edge rewrite rules, headers configuration, and live route tester",
      "icon": "vercel",
      "category": "system",
      "badge": "Schema",
      "navbar": true,
      "vercelRewrite": "/index.html"
    }
  ]
}
